    use crate::prelude::*;

    use crate::ops::Index;

    #[lang("vec")]
    pub struct Vec<T> {
        _priv: (),
    }

    impl<T> Vec<T> {
        pub fn new() -> Self {
            todo()
        }

        pub fn push<'a: &shorter Self>(&'a mut self, value: T) {
            todo()
        }

        pub fn clear<'a: &shorter Self>(&'a mut self) {
            todo()
        }

        pub fn get<'a: &shorter Self>(&'a self, idx: u32) -> &'a T {
            todo()
        }
    }

    impl<T> Index<u32> for Vec<T> {
        type Output = T;
    }

    impl<T: Clone> Clone for Vec<T> {
        fn clone<'a: &shorter Self>(&'a self) -> Self {
            todo()
        }
    }

    impl<'a: &shorter T, T> Iterator for &'a Vec<T> {
        type Item = &'a T;
    }
}

pub mod clone {
    use crate::prelude::*;

    pub trait Clone {
        fn clone<'a: &shorter Self>(&'a self) -> Self;
    }
}

pub fn identity<T>(value: T) -> T {
    value
}

pub fn drop<T>(value: T) {
    _ = value;
}

pub fn todo<T>() -> T {
    loop {}
}
