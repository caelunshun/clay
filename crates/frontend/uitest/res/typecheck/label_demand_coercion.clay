#[lang("deref_trait")]
trait Deref {
    type Target;
}

impl<'a, T: &longer 'a> Deref for &'a T {
    type Target = T;
}

impl<'a, T: &longer 'a> Deref for &'a mut T {
    type Target = T;
}

fn main() {
    let out;
    let foo = 'a: {
        if true {
            out = ();
            break 'a &out;
        }

        if true {
            out = ();
            break 'a &mut out;
        }

        // FIXME: no return unify error
    };
}
