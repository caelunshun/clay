fn concrete<'a, 'b>(magic: (&'a (), &'b ())) {
    // FIXME: This ICEs.
    // generic(magic);

    generic::<'a, 'b, _>(magic);

    // These are accepted.
    assert_outlives::<&'a (), (&'a (), &'b ())>();
    assert_outlives::<&'b (), (&'a (), &'b ())>();

    // These are rejected.
    assert_outlives::<(&'a (), &'b ()), &'a ()>();
    assert_outlives::<(&'a (), &'b ()), &'b ()>();
}

fn generic<'a, 'b, U: &shorter (&'a (), &'b ()) + &longer (&'a (), &'b ())>(magic: U) {
    // These are also accepted.
    assert_outlives::<&'a (), U>();
    assert_outlives::<&'b (), U>();

    // These are also rejected.
    assert_outlives::<U, &'a ()>();
    assert_outlives::<U, &'b ()>();
}

fn assert_outlives<LHS: &longer RHS, RHS>() {}
