trait Foo<'b> {
    type Out: &longer 'b;
}

fn demo<'a, T: for<'b> Foo<'b>>(_limiter: &'a ()) -> <T as Foo<'a>>::Out {
    loop {}
}

fn main<'a, T: for<'b> Foo<'b>>(foo: @(), bar: &'a ()) {
    // Accepted
    is_gc(demo::<'_, T>(foo));

    // Rejected
    // FIXME
    is_gc(demo::<'_, T>(bar));
}

fn is_gc<T: &longer 'gc>(v: T) {}
