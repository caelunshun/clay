trait Projector {
    type Out;
}

trait Helper<T, V> {}

trait Fuzzy {}

fn less_spec<Q: for<T: Projector> Helper<<T as Projector>::Out, T>>() {
    more_spec::<Q>;
}

fn more_spec<Q: for<T: Projector<Out: Fuzzy>> Helper<<T as Projector>::Out, T>>() {
    // FIXME: Should only produce a single diagnostic
    less_spec::<Q>;
}
